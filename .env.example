# Copy to .env and `source .env` (or export the variables) before running the pipeline.
# .env is git-ignored.

# Hugging Face: needed once to download the gated Llama-3.1 weights (read scope) and,
# when hf_push is enabled in the experiment YAML, to upload the adapter (write scope).
export HF_TOKEN=

# MLflow backend: the local PostgreSQL database `mlflow` (created by MLflow itself).
# Leave PG_USER/PG_PASS empty to fall back to a file store in ./mlruns.
export PG_USER=
export PG_PASS=
export PG_HOST=localhost
export PG_PORT=5432
# Or point straight at a tracking server / URI (takes precedence over PG_*):
# export MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# PostGIS reference database (CulturaEduca schema) used by execution-based evaluation.
export ATLAS_DSN="postgresql://USER:PASSWORD@localhost:5432/schools"

# Apple Silicon: let PyTorch use the whole unified memory for MPS tensors.
export PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.0
